{
  "manifest_version": 3,
  "name": "ChatGPT Supervisor Status",
  "version": "0.5.2",
  "description": "Statusy rozmow z bazy Nadzoru oraz zglaszanie, wyrejestrowanie MCP i archiwizowanie w ChatGPT.",
  "browser_specific_settings": {
    "gecko": {
      "id": "chatgpt-supervisor-status@lupus.local",
      "strict_min_version": "142.0",
      "update_url": "https://raw.githubusercontent.com/Pawel-BoOssko/chatgpt-supervisor-firefox-releases/main/updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "scripts": [
      "build-info.js",
      "coordinator-background.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "Nadzor: statusy i akcje czatu",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "build-info.js",
        "ui-model.js",
        "chat-index.js",
        "inventory-scan.js",
        "coordinator-client.js",
        "content.js",
        "right-panel.js",
        "inventory-controller.js"
      ],
      "css": [
        "content.css",
        "right-panel.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
